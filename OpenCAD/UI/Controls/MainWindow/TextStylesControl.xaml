<UserControl x:Class="UI.Controls.MainWindow.TextStylesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:opencad="clr-namespace:OpenCAD;assembly=OpenCAD"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="600"
             Background="{DynamicResource SecondaryBackgroundBrush}">
    <UserControl.Resources>
        <!-- Style for ComboBox in DataGrid -->
        <Style x:Key="DataGridComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SecondaryBackgroundBrush}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryTextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <ToolBarTray Grid.Row="0" Background="{DynamicResource SecondaryBackgroundBrush}">
            <ToolBar Background="{DynamicResource SecondaryBackgroundBrush}">
                <Button Command="{Binding NewTextStyleCommand}" 
                        ToolTip="New Text Style"
                        Padding="5,2">
                    <TextBlock Text="➕" FontSize="14"/>
                </Button>
                <Button Command="{Binding DeleteTextStyleCommand}" 
                        ToolTip="Delete Text Style"
                        Padding="5,2">
                    <TextBlock Text="🗑" FontSize="14"/>
                </Button>
                <Separator/>
                <Button Command="{Binding SetCurrentTextStyleCommand}" 
                        ToolTip="Set as Current Text Style"
                        Padding="5,2">
                    <TextBlock Text="✓" FontSize="14"/>
                </Button>
                <Separator/>
                <Button Command="{Binding RefreshCommand}" 
                        ToolTip="Refresh"
                        Padding="5,2">
                    <TextBlock Text="🔄" FontSize="14"/>
                </Button>
            </ToolBar>
        </ToolBarTray>

        <!-- Text Styles List -->
        <DataGrid Grid.Row="1"
                  x:Name="TextStylesDataGrid"
                  ItemsSource="{Binding TextStyles}"
                  SelectedItem="{Binding SelectedTextStyle}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  SelectionMode="Single"
                  Background="{DynamicResource SecondaryBackgroundBrush}"
                  Foreground="{DynamicResource PrimaryTextBrush}"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  RowHeaderWidth="0"
                  MouseDoubleClick="TextStylesDataGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <!-- Current Column -->
                <DataGridTextColumn Header="Current" 
                                    Width="60"
                                    IsReadOnly="True"
                                    Binding="{Binding CurrentIndicator}"/>

                <!-- Name Column - EDITABLE -->
                <DataGridTextColumn Header="Name" 
                                    Width="150"
                                    IsReadOnly="False"
                                    Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Font Family Column - Dropdown -->
                <DataGridTemplateColumn Header="Font Family" 
                                        Width="200">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding DataContext.AvailableFontFamilies, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                      SelectedItem="{Binding FontFamily, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource DataGridComboBoxStyle}"
                                      ToolTip="Select font family"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Font Size Column - EDITABLE -->
                <DataGridTextColumn Header="Font Size" 
                                    Width="100"
                                    IsReadOnly="False"
                                    Binding="{Binding FontSize, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Bold Column - Checkbox -->
                <DataGridCheckBoxColumn Header="Bold" 
                                        Width="60"
                                        Binding="{Binding IsBold, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Italic Column - Checkbox -->
                <DataGridCheckBoxColumn Header="Italic" 
                                        Width="60"
                                        Binding="{Binding IsItalic, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Underlined Column - Checkbox -->
                <DataGridCheckBoxColumn Header="Underline" 
                                        Width="80"
                                        Binding="{Binding IsUnderlined, UpdateSourceTrigger=PropertyChanged}"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>