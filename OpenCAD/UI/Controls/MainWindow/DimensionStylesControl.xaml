<UserControl x:Class="UI.Controls.MainWindow.DimensionStylesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:opencad="clr-namespace:OpenCAD;assembly=OpenCAD"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Background="{DynamicResource SecondaryBackgroundBrush}">
    <UserControl.Resources>
        <!-- Style for ComboBox in DataGrid -->
        <Style x:Key="DataGridComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SecondaryBackgroundBrush}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryTextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <ToolBarTray Grid.Row="0" Background="{DynamicResource SecondaryBackgroundBrush}">
            <ToolBar Background="{DynamicResource SecondaryBackgroundBrush}">
                <Button Command="{Binding NewDimensionStyleCommand}" 
                        ToolTip="New Dimension Style"
                        Padding="5,2">
                    <TextBlock Text="➕" FontSize="14"/>
                </Button>
                <Button Command="{Binding DeleteDimensionStyleCommand}" 
                        ToolTip="Delete Dimension Style"
                        Padding="5,2">
                    <TextBlock Text="🗑" FontSize="14"/>
                </Button>
                <Separator/>
                <Button Command="{Binding SetCurrentDimensionStyleCommand}" 
                        ToolTip="Set as Current Dimension Style"
                        Padding="5,2">
                    <TextBlock Text="✓" FontSize="14"/>
                </Button>
                <Separator/>
                <Button Command="{Binding RefreshCommand}" 
                        ToolTip="Refresh"
                        Padding="5,2">
                    <TextBlock Text="🔄" FontSize="14"/>
                </Button>
            </ToolBar>
        </ToolBarTray>

        <!-- Dimension Styles List -->
        <DataGrid Grid.Row="1"
                  x:Name="DimensionStylesDataGrid"
                  ItemsSource="{Binding DimensionStyles}"
                  SelectedItem="{Binding SelectedDimensionStyle}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  SelectionMode="Single"
                  Background="{DynamicResource SecondaryBackgroundBrush}"
                  Foreground="{DynamicResource PrimaryTextBrush}"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  RowHeaderWidth="0"
                  MouseDoubleClick="DimensionStylesDataGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <!-- Current Column -->
                <DataGridTextColumn Header="Current" 
                                    Width="60"
                                    IsReadOnly="True"
                                    Binding="{Binding CurrentIndicator}"/>

                <!-- Name Column - EDITABLE -->
                <DataGridTextColumn Header="Name" 
                                    Width="120"
                                    IsReadOnly="False"
                                    Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Arrow Type Column - Dropdown -->
                <DataGridTemplateColumn Header="Arrow Type" 
                                        Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding DataContext.AvailableArrowTypes, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                      SelectedItem="{Binding ArrowType, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource DataGridComboBoxStyle}"
                                      ToolTip="Select arrow type"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Arrow Size Column - EDITABLE -->
                <DataGridTextColumn Header="Arrow Size" 
                                    Width="80"
                                    IsReadOnly="False"
                                    Binding="{Binding ArrowSizeText, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Text Style Column - Dropdown -->
                <DataGridTemplateColumn Header="Text Style" 
                                        Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding DataContext.AvailableTextStyles, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                      SelectedItem="{Binding TextStyle, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource DataGridComboBoxStyle}"
                                      ToolTip="Select text style">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Text Height Column - EDITABLE -->
                <DataGridTextColumn Header="Text Height" 
                                    Width="80"
                                    IsReadOnly="False"
                                    Binding="{Binding TextHeightText, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Offset Column - EDITABLE -->
                <DataGridTextColumn Header="Offset" 
                                    Width="70"
                                    IsReadOnly="False"
                                    Binding="{Binding OffsetText, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Extension Length Column - EDITABLE -->
                <DataGridTextColumn Header="Ext Length" 
                                    Width="80"
                                    IsReadOnly="False"
                                    Binding="{Binding ExtensionLengthText, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Extension Offset Column - EDITABLE -->
                <DataGridTextColumn Header="Ext Offset" 
                                    Width="80"
                                    IsReadOnly="False"
                                    Binding="{Binding ExtensionOffsetText, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Extension Beyond Column - EDITABLE -->
                <DataGridTextColumn Header="Ext Beyond" 
                                    Width="80"
                                    IsReadOnly="False"
                                    Binding="{Binding ExtensionBeyondText, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Scale Column - EDITABLE -->
                <DataGridTextColumn Header="Scale" 
                                    Width="70"
                                    IsReadOnly="False"
                                    Binding="{Binding ScaleText, UpdateSourceTrigger=PropertyChanged}"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>