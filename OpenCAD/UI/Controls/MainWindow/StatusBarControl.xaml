<UserControl x:Class="UI.Controls.MainWindow.StatusBarControl"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
       xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:local="clr-namespace:UI.Controls.MainWindow"
   mc:Ignorable="d" 
     d:DesignHeight="25" d:DesignWidth="800">
    
    <StatusBar Height="25" Background="{DynamicResource StatusBarBackgroundBrush}"
               Foreground="White">
     <StatusBarItem>
      <TextBlock x:Name="statusTextBlock" Text="Ready" />
        </StatusBarItem>
        
        <!-- Grid toggle button -->
        <StatusBarItem>
            <ToggleButton x:Name="gridToggleButton" 
                          Style="{StaticResource StatusBarToggleButtonStyle}"
                          Content="GRID"
                          ToolTip="Toggle grid display (ON/OFF)"
                          Click="GridToggleButton_Click"/>
        </StatusBarItem>
        
        <!-- Snap toggle button -->
        <StatusBarItem>
            <ToggleButton x:Name="snapToggleButton" 
                          Style="{StaticResource StatusBarToggleButtonStyle}"
                          Content="SNAP"
                          ToolTip="Toggle snap to grid (ON/OFF)"
                          Click="SnapToggleButton_Click"/>
        </StatusBarItem>

		<!-- GeoSnap toggle button -->
		<StatusBarItem>
			<ToggleButton x:Name="geoSnapToggleButton"
                          Style="{StaticResource StatusBarToggleButtonStyle}"
                          Content="GEOSNAP"
                          ToolTip="Toggle snap to grid (ON/OFF)"
                          Click="GeoSnapToggleButton_Click"/>
		</StatusBarItem>

		<StatusBarItem HorizontalAlignment="Right">
     <TextBlock x:Name="positionTextBlock" Text="Line 1, Col 1" />
        </StatusBarItem>
    </StatusBar>
</UserControl>
