<Window x:Class="UI.Controls.MainWindow.GeoPointModesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GeoPoint Modes" Height="400" Width="300" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock Text="Select GeoPoint Modes:" FontWeight="Bold" Margin="0,0,0,8"/>
        <ItemsControl x:Name="ModesItemsControl">
            <!-- CheckBoxes will be added in code-behind -->
        </ItemsControl>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="OK" Width="80" Margin="0,0,8,0" Click="OkButton_Click"/>
            <Button Content="Cancel" Width="80" Click="CancelButton_Click"/>
        </StackPanel>
    </StackPanel>
</Window>